# ==========================================
# AllamSec - Git Ignore Configuration
# Security Monitoring & Threat Detection
# ==========================================


# ------------------------------------------
# Python virtual environments
# ------------------------------------------
.venv/
venv/
env/


# ------------------------------------------
# Python cache and compiled files
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class


# ------------------------------------------
# Python testing and coverage
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/


# ------------------------------------------
# Environment variables and secrets
# ------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx


# ------------------------------------------
# Local databases
# ------------------------------------------
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*


# ------------------------------------------
# IDE and editor settings
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo


# ------------------------------------------
# Operating system files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini


# ------------------------------------------
# Generated reports and exports
# ------------------------------------------
reports/
exports/


# ------------------------------------------
# Private or sensitive security logs
# ------------------------------------------
data/private/
data/raw/


# ------------------------------------------
# Flask application files
# ------------------------------------------
instance/
.webassets-cache/

# AllamSec SQLite database files
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm